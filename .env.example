# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alfaer?schema=public"

# Session cookie Secure flag. Leave unset to enable it automatically in
# production. Set to "false" only when serving over plain HTTP on a trusted
# internal network — a Secure cookie is not sent with the requests that carry
# form submissions over HTTP, so writes fail while pages still load.
# AUTH_COOKIE_SECURE=false
