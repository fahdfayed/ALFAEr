generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A contract / site. Everything is scoped to one of these.
/// A person who can sign in. Users are global; what they may do is decided
/// per project by their Membership.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  /// System administrator: manages users and creates projects. Independent of
  /// project roles, because whoever administers the system is not necessarily
  /// the engineer on any particular job.
  isAdmin      Boolean @default(false)
  active       Boolean @default(true)

  lastLoginAt DateTime?

  memberships  Membership[]
  sessions     Session[]
  auditEntries AuditEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  VIEWER
  FOREMAN
  ENGINEER
}

/// What one user may do on one project.
model Membership {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  role Role @default(FOREMAN)

  createdAt DateTime @default(now())

  @@unique([userId, siteId])
  @@index([siteId])
}

/// A signed-in browser. Only the hash of the session token is stored, so a
/// leaked database does not hand over live sessions.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Failed sign-in attempts, used to slow down guessing. Cleared on success.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// Who changed what, when, and from what to what. The reason a pile log PDF
/// can be defended six months later.
model AuditEntry {
  id     String  @id @default(cuid())
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Kept alongside actorId so the trail still reads correctly after a user
  /// is deleted.
  actorName String

  action      AuditAction
  /// Model name, e.g. "PileLog".
  entity      String
  entityId    String
  /// Human-readable identifier, e.g. "P-101", so the log is legible without
  /// resolving ids.
  entityLabel String

  /// Field-level before/after values: { field: { from, to } }.
  changes Json?
  reason  String?

  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([entity, entityId])
}

model Site {
  id          String  @id @default(cuid())
  name        String
  clientName  String?
  contractRef String?
  location    String?

  /// Overbreak above this percentage is flagged red on the dashboard.
  overbreakRedPct   Float @default(15)
  /// Overbreak above this percentage is flagged amber.
  overbreakAmberPct Float @default(8)

  /// Planned working hours per rig per shift, used as the denominator for
  /// utilisation. Without it "utilisation" has no meaningful base.
  shiftHours Float @default(10)

  /// Used to price the additional concrete on the overbreak dashboard.
  concreteRatePerM3 Float?
  currency          String @default("AED")

  /// Archived projects stay readable but drop out of the switcher.
  archived Boolean @default(false)

  rigs         Rig[]
  drillers     Driller[]
  piles        Pile[]
  dailyReports DailyReport[]
  delays       Delay[]
  memberships  Membership[]
  auditEntries AuditEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rig {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  name   String
  make   String?
  active Boolean @default(true)

  logs   PileLog[]
  delays Delay[]

  @@unique([siteId, name])
}

model Driller {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  name   String
  active Boolean @default(true)

  logs PileLog[]

  @@unique([siteId, name])
}

enum PileStatus {
  NOT_STARTED
  BORED
  CAST
  TESTED
  ACCEPTED
  REJECTED
}

/// One pile from the setting-out schedule. Exists before any work happens,
/// which is what lets the progress board show "not started" piles.
model Pile {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// Pile mark from the setting-out drawing, e.g. "P-101".
  ref       String
  gridRef   String?
  /// Setting-out coordinates, used to draw the layout progress board.
  eastingM  Float?
  northingM Float?

  designDiameterMm     Int
  designToeDepthM      Float
  designCutoffLevelM   Float?
  designPlatformLevelM Float?

  status PileStatus @default(NOT_STARTED)

  log PileLog?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, ref])
  @@index([siteId, status])
}

/// The as-built record for a pile — the digital version of the paper sheet.
model PileLog {
  id   String @id
  pile Pile   @relation(fields: [id], references: [id], onDelete: Cascade)

  /// The shift this pile belongs to, for the daily site report.
  workDate DateTime @db.Date

  rigId     String?
  rig       Rig?     @relation(fields: [rigId], references: [id], onDelete: SetNull)
  drillerId String?
  driller   Driller? @relation(fields: [drillerId], references: [id], onDelete: SetNull)

  // --- Bore ---
  boreStartedAt     DateTime?
  boreFinishedAt    DateTime?
  asBuiltDiameterMm Int
  toeDepthM         Float
  platformLevelM    Float?
  cutoffLevelM      Float?
  waterStrikeDepthM Float?
  verticalityPct    Float?

  // --- Casing ---
  casingDepthM     Float?
  casingDiameterMm Int?
  casingType       String?

  // --- Reinforcement cage ---
  cageMark        String?
  cageLengthM     Float?
  cageDiameterMm  Int?
  cageMainBars    String?
  cageLinks       String?
  cageTopDepthM   Float?
  cageInstalledAt DateTime?

  // --- Concrete ---
  concreteStartedAt  DateTime?
  concreteFinishedAt DateTime?
  concreteGrade      String?
  concreteMixRef     String?
  slumpMm            Int?
  cubesTaken         Int?      @default(0)
  /// Depth below platform of the top of the cast concrete. 0 = cast to platform.
  concreteTopDepthM  Float     @default(0)
  /// Total m3 actually placed. Kept in sync with the sum of the load tickets
  /// when any are recorded.
  pouredVolumeM3     Float

  strata  String?
  weather String?
  remarks String?

  loads  ConcreteLoad[]
  delays Delay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workDate])
}

/// One concrete delivery ticket against a pile.
model ConcreteLoad {
  id        String  @id @default(cuid())
  pileLogId String
  pileLog   PileLog @relation(fields: [pileLogId], references: [id], onDelete: Cascade)

  ticketRef String?
  volumeM3  Float
  arrivedAt DateTime?
  slumpMm   Int?
  sequence  Int       @default(0)

  @@index([pileLogId])
}

/// Per-day narrative that isn't attached to any single pile. The pile rows on
/// the daily report PDF are derived from PileLog.workDate.
model DailyReport {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  reportDate DateTime @db.Date

  weather        String?
  temperatureC   Int?
  personnelCount Int?
  plantOnSite    String?
  delays         String?
  hseNotes       String?
  visitors       String?
  generalNotes   String?
  preparedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, reportDate])
}

/// Broad cause of lost time. Kept coarse on purpose: the value of delay data
/// comes from consistent grouping, and a driller picking from six buttons on a
/// phone will do it, where a free-text box gets left empty.
enum DelayCategory {
  EQUIPMENT
  CONCRETE
  REINFORCEMENT
  SITE
  GROUND
  CLIENT
  OTHER
}

/// A period where production stopped. Recorded at the point it happens so the
/// daily report and the lost-time dashboard build themselves.
model Delay {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// The shift this delay belongs to, matching PileLog.workDate.
  workDate DateTime @db.Date

  category DelayCategory
  /// The specific reason within the category, from a configurable pick list.
  reason   String

  rigId String?
  rig   Rig?    @relation(fields: [rigId], references: [id], onDelete: SetNull)

  /// Set when the delay stopped one particular pile rather than the whole site.
  pileLogId String?
  pileLog   PileLog? @relation(fields: [pileLogId], references: [id], onDelete: SetNull)

  startedAt DateTime
  endedAt   DateTime?
  /// Cached so lost-time totals do not depend on re-deriving from timestamps,
  /// and so an ongoing delay can be counted up to now without a write.
  minutes   Int?

  notes      String?
  recordedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, workDate])
  @@index([siteId, category])
}
